+// Internal to libroscpp. No public API or Connection layout changes.
+#ifndef ROSCPP_DEFERRED_WRITE_H
+#define ROSCPP_DEFERRED_WRITE_H
+
+#include "ros/connection.h"
+#include "ros/transport/transport_tcp.h"
+#include <vector>
+
+namespace ros
+{
+namespace detail
+{
+class DeferredWritePhase;
+extern __attribute__((visibility("hidden"))) thread_local DeferredWritePhase* deferred_write_phase;
+
+class __attribute__((visibility("hidden"))) DeferredWritePhase
+{
+public:
+  DeferredWritePhase(PollSet& owner, std::vector<ConnectionPtr>& writes)
+    : previous_(deferred_write_phase), owner_(&owner), writes_(writes)
+  {
+    deferred_write_phase = this;
+  }
+  ~DeferredWritePhase() { deferred_write_phase = previous_; }
+
+  static bool enqueue(Connection* connection)
+  {
+    if (!deferred_write_phase)
+      return false;
+    TransportTCP* tcp = dynamic_cast<TransportTCP*>(connection->getTransport().get());
+    if (!tcp || tcp->poll_set_ != deferred_write_phase->owner_ ||
+        (tcp->flags_ & TransportTCP::SYNCHRONOUS))
+      return false;
+    deferred_write_phase->writes_.push_back(connection->shared_from_this());
+    return true;
+  }
+
+  static void drain(std::vector<ConnectionPtr>& writes)
+  {
+    struct ClearOnExit
+    {
+      std::vector<ConnectionPtr>& writes;
+      ~ClearOnExit() { writes.clear(); }
+    } clear = {writes};
+    for (const ConnectionPtr& connection : writes)
+      connection->drainDeferredWrite();
+  }
+
+private:
+  DeferredWritePhase(const DeferredWritePhase&) = delete;
+  DeferredWritePhase& operator=(const DeferredWritePhase&) = delete;
+  DeferredWritePhase* previous_;
+  const PollSet* owner_;
+  std::vector<ConnectionPtr>& writes_;
+};
+}
+}
+#endif
