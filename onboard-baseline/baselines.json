{
  "owner": "onboard-baseline/onboard-baseline.sh",
  "agentPackage": "xgc2-agent",
  "note": "A profile is one selectable image, not the only image for a robot kind. defaults are the current starting choice; explicit profiles remain available and are not implied by the kind. Scout's default is AGX: agilex, Ubuntu Bionic 18.04, ROS Melodic. The existing Scout Orin profile is an explicit option and is not extended here. FS150's default is marvsmart on Focal/Noetic. Wheeltec's default is wheeltec on Bionic/Melodic. The same onboard-baseline.sh --profile prepares a container build and a real machine. The image starts only the Agent daemon.",
  "selection": {
    "defaults": {
      "fs150": "fs150-focal-noetic",
      "scout": "scout-bionic-melodic",
      "wheeltec": "wheeltec-bionic-melodic"
    },
    "explicit": ["scout-focal-noetic"]
  },
  "profiles": {
    "fs150-focal-noetic": {
      "username": "marvsmart",
      "ubuntuCodename": "focal",
      "ubuntuVersionId": "20.04",
      "rosDistro": "noetic",
      "architectures": ["amd64", "arm64"],
      "packages": ["ca-certificates", "curl", "gnupg", "sudo", "systemd", "init-system-helpers", "iproute2", "util-linux", "procps", "python3", "ros-noetic-ros-base", "ros-noetic-mavros", "geographiclib-tools", "wget", "bzip2"]
    },
    "scout-bionic-melodic": {
      "username": "agilex",
      "ubuntuCodename": "bionic",
      "ubuntuVersionId": "18.04",
      "rosDistro": "melodic",
      "architectures": ["amd64", "arm64"],
      "packages": ["ca-certificates", "curl", "gnupg", "sudo", "systemd", "init-system-helpers", "iproute2", "util-linux", "procps", "python3", "ros-melodic-ros-base"]
    },
    "scout-focal-noetic": {
      "username": "nvidia",
      "ubuntuCodename": "focal",
      "ubuntuVersionId": "20.04",
      "rosDistro": "noetic",
      "architectures": ["amd64", "arm64"],
      "packages": ["ca-certificates", "curl", "gnupg", "sudo", "systemd", "init-system-helpers", "iproute2", "util-linux", "procps", "python3", "ros-noetic-ros-base"]
    },
    "wheeltec-bionic-melodic": {
      "username": "wheeltec",
      "ubuntuCodename": "bionic",
      "ubuntuVersionId": "18.04",
      "rosDistro": "melodic",
      "architectures": ["amd64", "arm64"],
      "packages": ["ca-certificates", "curl", "gnupg", "sudo", "systemd", "init-system-helpers", "iproute2", "util-linux", "procps", "python3", "ros-melodic-ros-base"]
    }
  }
