{
  "owner": "onboard-baseline/onboard-baseline.sh",
  "agentPackage": "xgc2-agent",
  "note": "Third-party onboard base environments. Profiles align distribution, ROS and robot account, not a complete physical root filesystem. Base images contain no XGC2 products or physical hardware drivers. Agent and simulation/algorithm products belong to a separate local source-built full image.",
  "selection": {
    "defaults": {
      "fs150": "fs150-focal-noetic",
      "scout": "scout-bionic-melodic",
      "wheeltec": "wheeltec-bionic-melodic"
    },
    "explicit": [
      "scout-focal-noetic"
    ]
  },
  "profiles": {
    "fs150-focal-noetic": {
      "robotKind": "px4_multirotor",
      "username": "marvsmart",
      "ubuntuCodename": "focal",
      "ubuntuVersionId": "20.04",
      "rosDistro": "noetic",
      "architectures": [
        "amd64",
        "arm64"
      ],
      "packages": [
        "ca-certificates",
        "curl",
        "gnupg",
        "sudo",
        "systemd",
        "init-system-helpers",
        "iproute2",
        "util-linux",
        "procps",
        "python3",
        "ros-noetic-ros-base",
        "ros-noetic-mavros",
        "geographiclib-tools",
        "wget",
        "bzip2"
      ]
    },
